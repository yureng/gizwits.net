<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-ios;net10.0-android</TargetFrameworks>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>

		<PackageId>Gizwits.Net</PackageId>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>MAUI,iOS,Android,gizwits,sdk</PackageTags>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>Gizwits SDK wrapper for .Net MAUI</PackageReleaseNotes>
		<PackageProjectUrl>https://github.com/yureng/gizwits.net</PackageProjectUrl>
		<RepositoryUrl>https://github.com/yureng/gizwits.net</RepositoryUrl>

		<RestoreProjectStyle>PackageReference</RestoreProjectStyle>

		<Product>$(AssemblyName) ($(TargetFramework))</Product>
		<Version>1.0.3</Version>
		<Title>Gizwits SDK wrapper</Title>
		<Description>Gizwits SDK wrapper for .NET MAUI</Description>
		<Owners>xiaojun.zhu</Owners>
		<Authors>xiaojun.zhu</Authors>
		<Copyright>xiaojun.zhu@outlook.com</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
	  <PackageReference Include="Gizwits.Net.iOS">
	    <Version>1.0.3</Version>
	  </PackageReference>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
	  <PackageReference Include="Gizwits.Net.Android">
	    <Version>1.0.3</Version>
	  </PackageReference>
	</ItemGroup>

</Project>
